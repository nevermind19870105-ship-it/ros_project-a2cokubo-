<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <gravity>0 0 -9.8</gravity>
    <physics type="ode"><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate></physics>
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <plugin name="rmagine_embree_map" filename="/opt/ros/noetic/lib/librmagine_embree_map_gzplugin.so">
      <update><delta_trans>0.001</delta_trans><delta_rot>0.001</delta_rot><delta_scale>0.001</delta_scale><rate_limit>200</rate_limit></update>
    </plugin>
  </world>
</sdf>
