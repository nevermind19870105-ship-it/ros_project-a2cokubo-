<launch>
  <arg name="image_topic" default="/shooter/camera/image_raw"/>
  <arg name="gui" default="true"/>
  <arg name="world" default="$(find aiming_robot)/worlds/radar_demo.world"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="extra_gazebo_args" value="-s /opt/ros/noetic/lib/libradarays_embree_sensors_gzregister.so"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <param name="robot_description" textfile="$(find aiming_robot)/urdf/shooter.urdf"/>
  <node name="spawn_camera_gimbal" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-urdf -model camera_gimbal -param robot_description -x 0 -y 0 -z 0.05"/>

  <node pkg="robot_state_publisher" type="robot_state_publisher" name="shooter_state_publisher" output="screen">
    <param name="publish_frequency" value="30.0"/>
    <remap from="joint_states" to="/shooter/joint_states"/>
  </node>

  <param name="demo_marker_description" textfile="$(find aiming_robot)/urdf/demo_marker.urdf"/>
  <node name="spawn_demo_marker" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-urdf -model demo_marker -param demo_marker_description -x 2.8 -y 0.2 -z 1.5"/>

  <node pkg="aiming_robot" type="configure_radar.py" name="configure_radar" output="screen"/>
  <node pkg="aiming_robot" type="radar_target_tracker.py" name="radar_target_tracker" output="screen">
    <param name="range_resolution" value="0.0438"/>
    <param name="min_range" value="0.6"/>
    <param name="max_range" value="8.0"/>
    <param name="min_intensity" value="20"/>
    <param name="sensor_y_offset" value="0.14"/>
    <param name="scan_height" value="1.50"/>
    <param name="prediction_horizon" value="0.25"/>
  </node>

  <rosparam file="$(find aiming_robot)/config/shooter_control.yaml" command="load"/>
  <node name="gimbal_controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
        output="screen" ns="/shooter"
        args="joint_state_controller pan_position_controller tilt_position_controller"/>

  <node pkg="aiming_robot" type="move_demo_marker.py" name="move_demo_marker" output="screen"/>
  <node pkg="aiming_robot" type="vision_marker_tracker.py" name="vision_marker_tracker" output="screen">
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="output_topic" value="/vision/annotated_image"/>
    <param name="offset_topic" value="/vision/marker_offset"/>
    <param name="prediction_horizon" value="0.25"/>
    <param name="history_length" value="8"/>
    <param name="predictor_mode" value="mlp"/>
    <param name="model_path" value="$(find aiming_robot)/models/trajectory_mlp.npz"/>
    <rosparam param="hsv_lower">[40, 70, 70]</rosparam>
    <rosparam param="hsv_upper">[85, 255, 255]</rosparam>
  </node>
  <node pkg="aiming_robot" type="camera_gimbal_controller.py" name="camera_gimbal_controller" output="screen">
    <param name="target_source" value="radar"/>
    <param name="radar_topic" value="/radar/predicted_target_position"/>
    <param name="aim_origin_z" value="0.25"/>
  </node>
  <node pkg="aiming_robot" type="gazebo_status_dashboard.py" name="gazebo_status_dashboard" output="screen">
    <param name="image_topic" value="/vision/annotated_image"/>
    <param name="joint_state_topic" value="/shooter/joint_states"/>
    <param name="model_states_topic" value="/gazebo/model_states"/>
    <param name="predicted_pixel_topic" value="/vision/predicted_pixel"/>
    <param name="marker_model" value="demo_marker"/>
    <param name="gimbal_model" value="camera_gimbal"/>
    <param name="horizontal_fov_degrees" value="60.0"/>
    <param name="marker_diameter" value="0.30"/>
    <param name="camera_forward_offset" value="0.30"/>
    <param name="radar_prediction_horizon" value="0.25"/>
  </node>
</launch>
