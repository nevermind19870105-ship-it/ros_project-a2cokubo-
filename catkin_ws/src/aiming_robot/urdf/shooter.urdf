<?xml version="1.0"?>
<robot name="shooter">

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.2"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Pan Link (Yaw rotation around Z) -->
  <link name="pan_link">
    <visual>
      <geometry>
        <box size="0.15 0.15 0.2"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.15 0.15 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="pan_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="2.0"/>
  </joint>

  <!-- Tilt Link / Cannon Barrel (Pitch rotation around Y) -->
  <link name="tilt_link">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.3" radius="0.04"/>
      </geometry>
      <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.15 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.3" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.15 0 0" rpy="0 1.5708 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="tilt_joint" type="revolute">
    <parent link="pan_link"/>
    <child link="tilt_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="2.0"/>
  </joint>

  <!-- Transmissions -->
  <transmission name="pan_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="pan_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="pan_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="tilt_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="tilt_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="tilt_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- Gazebo Plugin -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/shooter</robotNamespace>
    </plugin>
  </gazebo>

  <!-- FMCW radar sensors mounted on the left and right of the fixed base.
       The center camera remains on the pan/tilt link above. -->
  <link name="radar_left_link"/>
  <joint name="radar_left_mount" type="fixed">
    <parent link="base_link"/>
    <child link="radar_left_link"/>
    <origin xyz="0 0.14 1.45" rpy="0 0 0"/>
  </joint>
  <gazebo reference="radar_left_link">
    <sensor type="radarays_embree" name="radar_left_sensor">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>4</update_rate>
      <ray><scan><horizontal>
        <min_angle>-3.141593</min_angle><max_angle>3.141593</max_angle>
        <samples>400</samples><resolution>1</resolution>
      </horizontal></scan><range><min>0.2</min><max>30.0</max><resolution>0.0438</resolution></range></ray>
      <plugin name="radarays_left_ros" filename="/opt/ros/noetic/lib/libradarays_embree_ros_gzplugin.so">
        <frame>radar_left_link</frame><topic>/shooter/radar_left/image</topic>
      </plugin>
    </sensor>
  </gazebo>

  <link name="radar_right_link"/>
  <joint name="radar_right_mount" type="fixed">
    <parent link="base_link"/>
    <child link="radar_right_link"/>
    <origin xyz="0 -0.14 1.45" rpy="0 0 0"/>
  </joint>
  <gazebo reference="radar_right_link">
    <sensor type="radarays_embree" name="radar_right_sensor">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>4</update_rate>
      <ray><scan><horizontal>
        <min_angle>-3.141593</min_angle><max_angle>3.141593</max_angle>
        <samples>400</samples><resolution>1</resolution>
      </horizontal></scan><range><min>0.2</min><max>30.0</max><resolution>0.0438</resolution></range></ray>
      <plugin name="radarays_right_ros" filename="/opt/ros/noetic/lib/libradarays_embree_ros_gzplugin.so">
        <frame>radar_right_link</frame><topic>/shooter/radar_right/image</topic>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Camera sensor for the non-firing Gazebo gimbal demonstration. -->
  <gazebo reference="tilt_link">
    <sensor type="camera" name="gimbal_camera_sensor">
      <pose>0.30 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.047198</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>30.0</far></clip>
      </camera>
      <plugin name="gimbal_camera_ros" filename="libgazebo_ros_camera.so">
        <robotNamespace>/shooter</robotNamespace>
        <cameraName>camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>tilt_link</frameName>
        <hackBaseline>0.0</hackBaseline>
      </plugin>
    </sensor>
  </gazebo>

</robot>
